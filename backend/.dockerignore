# Build context is the backend/ directory (see backend/Dockerfile).
# Keep secrets, VCS metadata, local config, and dev artifacts OUT of the image
# so nothing sensitive is baked into an image layer.

# Secrets / local env
.env
.env.*
*.env

# Azure / deployment config
.azure/
*.azure*

# VCS
.git
.git/
.gitignore

# Python caches / build junk
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Tests and dev artifacts (not needed at runtime)
test_*.py
*_test.py
quality_last_run.json
*.log
*.wav
*.m4a

# Docs
README.md
*.md

# In case the image is ever built from the repo root by mistake
../.env
frontend/
node_modules/
